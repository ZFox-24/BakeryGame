config_version=5

[application]

config/name="Игра - пекарня \"Булочка с маком\""
config/version="1.0 pre-release"
run/main_scene="uid://dtggv2wnvtmbp"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="uid://dww7s2spbgd37"

[autoload]

Warehouse="*res://confectionery_products/warehouse.gd"
VisitorManager="*res://scenes/visitor_manager.gd"
SaveLoad="*res://saving system/save_load.gd"
OrderManager="*res://scripts/order_manager.gd"
SavesManagement="*res://saving system/saves_management.gd"
SaveManagerLite="*res://addons/SaveManagerLite/SaveManagerLite.gd"
SceneManager="*res://scenes/scene_manager.gd"
GameSettings="*res://scripts/game_settings.gd"
Moneyyy="*res://scripts/Moneyyy.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Игра - пекарня -Булочка с маком-"

[editor_plugins]

enabled=PackedStringArray("res://addons/SaveManagerLite/plugin.cfg", "res://addons/project-time-tracker/plugin.cfg", "res://addons/scene_object_brush/plugin.cfg")

