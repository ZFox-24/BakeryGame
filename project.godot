[internationalization]

locale/translations=PackedStringArray("res://translations/translations.en.translation", "res://translations/translations.ru.translation")

[physics]

common/use_occlusion_culling=true

[project_time_traker]

sections/show_sections=true
sections/show_graphs=true
afk/afk_timer=300

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
occlusion_culling/use_occlusion_culling=true
